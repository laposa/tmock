# Example configuration for local development. Copy to .env and adjust:
#
#   cp .env.example .env
#
# Real environment variables win over .env. Empty values count as unset. The full list,
# with defaults, is in spec.md §4.2.

# ── Server ──────────────────────────────────────────────────────────────────────────────
PORT=3000
TMOCK_ENV=development
# TZ=Europe/Dublin

# Required when TMOCK_ENV=production; at least 32 characters (openssl rand -base64 48).
# When unset outside production, a random secret is used and sessions end on restart.
SESSION_SECRET=

# ── Database (used from I02 on; matches `make db-up`) ──────────────────────────────────
# DATABASE_URL=postgres://tmock:tmock@localhost:5432/tmock?sslmode=disable
# or, instead of DATABASE_URL:
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=tmock
# DATABASE_USER=tmock
# DATABASE_PASSWORD=tmock
# DATABASE_ENABLE_SSL=false

# ── Proxy ───────────────────────────────────────────────────────────────────────────────
# DISABLE_CACHE=false
# CACHE_TTL=10m
# SERVICES_API_KEY=
# Pattern: <service-path>::<upstream-url>, separated by commas
# SERVICES_UPSTREAM_OVERRIDES=users::http://localhost:9000
# PROXY_REMOVE_FORWARDED_HEADERS=false
# PROXY_UPSTREAM_TIMEOUT=30s
# PROXY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Logging ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text
# Export logs to the local collector from `make otel-up`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
